# Application
APP_NAME="PayBook"
APP_ENV=local
DEBUG=true

# Database (psycopg3 driver works for both the app's async engine and Alembic's sync migrations)
# postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://inventory_agent:inventory_agent@localhost:5432/inventory_agent

# CORS - comma separated list of allowed origins, or * for all
CORS_ORIGINS=*

# Signs every JWT access/refresh token -- the dev default below is fine for
# local development, but the app refuses to start with it if APP_ENV isn't
# "local" (see app/core/config.py). Generate a real one for anywhere else:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-insecure-secret-key-change-me

# ---------------------------------------------------------------------------
# Supabase Storage -- customer/manufacturer photos and shop logo/image
# (app/core/storage.py). Uploads no-op with a clear error until these are set;
# everything else in the app works fine without them.
#   1. In the Supabase dashboard -> Storage, create a new bucket (suggested
#      name: app-images), set it Public (these are just business photos, not
#      sensitive documents -- Public keeps read URLs simple, no signed URLs).
#   2. Project Settings -> API -> copy the "service_role" key (NOT the anon
#      key -- this backend uploads on the user's behalf via its own auth, so
#      it needs the elevated key; never ship this key to the mobile app).
#   3. SUPABASE_URL is the same project URL as your Supabase dashboard, e.g.
#      https://<project-ref>.supabase.co (no trailing /storage/v1).
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=app-images

# ---------------------------------------------------------------------------
# Production checklist (set these on whatever platform hosts the backend --
# Railway/Render/Fly/a VPS -- not in this file, which is for local dev only):
#   APP_ENV=production
#   DEBUG=false
#   SECRET_KEY=<freshly generated, never reused from dev>
#   DATABASE_URL=<see the Supabase section below>
#   CORS_ORIGINS=*   (left open deliberately -- the mobile app isn't a browser
#                      and isn't subject to CORS at all; the admin dashboard is
#                      served same-origin from this same API; auth uses a
#                      Bearer token, not cookies, so the usual cross-origin
#                      credential-theft risk CORS restrictions guard against
#                      doesn't apply here. Tighten later if it ever needs to.)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Using Supabase for the production database:
#   1. Create a project at supabase.com -- note the database password you set,
#      Supabase only shows it once.
#   2. Project Settings -> Database -> Connection string. Use the "Session"
#      pooler mode (or the direct connection), NOT "Transaction" mode -- this
#      app holds a persistent SQLAlchemy connection pool rather than opening a
#      fresh short-lived connection per request, and Transaction-mode pooling
#      (Supavisor/PgBouncer) disables prepared statements and other
#      session-level features SQLAlchemy relies on.
#   3. Supabase gives you a plain "postgresql://..." URL -- change the scheme
#      to "postgresql+psycopg://" (this app uses the psycopg3 driver, already
#      in requirements.txt) and set it as DATABASE_URL. Example shape:
#      postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   4. Supabase requires SSL; psycopg3 negotiates it automatically against a
#      Supabase host, so no extra `?sslmode=` param is normally needed.
#   5. Run `alembic upgrade head` once against this DATABASE_URL (creates the
#      schema + the bootstrap admin -- see migrations/versions/1e0ba68952fe_*)
#      before pointing the deployed backend at it.
# ---------------------------------------------------------------------------
